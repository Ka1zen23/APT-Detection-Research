# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------

# Backend bind address (localhost only by default)
APT_DASHBOARD_HOST=127.0.0.1
APT_DASHBOARD_PORT=8000

# In-memory artifact cache TTL in seconds
APT_DASHBOARD_CACHE_TTL=15

# Optional repository root override (containers use /app)
# APT_REPO_ROOT=/app

# Deployment mode shown in /health: local | container
APT_DEPLOYMENT_MODE=local

# Comma-separated browser origins allowed to call the API directly.
# The Vercel proxy calls the API server-to-server, so production does not need CORS.
# APT_CORS_ORIGINS=https://your-dashboard.vercel.app

# Service-to-service key. Leave empty for local development with no auth.
# In production, set the same value on the API host and in Vercel.
APT_API_KEY=

# ---------------------------------------------------------------------------
# Vercel proxy (server-side only; do not prefix with VITE_)
# ---------------------------------------------------------------------------
# Public origin of the Fly.io API, without a trailing slash.
# API_ORIGIN=https://apt-research-api.fly.dev

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Leave empty during `npm run dev` to use the Vite /api proxy.
# The Vercel deployment intentionally uses the same-origin /api/v1 proxy.
VITE_API_BASE_URL=
