# Backend bind address (localhost only by default)
APT_DASHBOARD_HOST=127.0.0.1
APT_DASHBOARD_PORT=8000

# In-memory artifact cache TTL in seconds
APT_DASHBOARD_CACHE_TTL=15

# Frontend API base URL.
# Leave empty during `npm run dev` to use the Vite /api proxy.
# For preview/production set the full versioned API URL:
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_API_BASE_URL=
