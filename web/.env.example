# ---------------------------------------------------------------------------
# Local research dashboard
# ---------------------------------------------------------------------------

# Backend bind address (localhost only by default)
APT_DASHBOARD_HOST=127.0.0.1
APT_DASHBOARD_PORT=8000

# In-memory artifact cache TTL in seconds
APT_DASHBOARD_CACHE_TTL=15

# Deployment mode shown in /health: local | static | container
APT_DEPLOYMENT_MODE=local

# Comma-separated browser origins allowed to call the local API directly.
# APT_CORS_ORIGINS=http://localhost:5173

# Optional service key if the local API is ever exposed beyond localhost.
APT_API_KEY=

# ---------------------------------------------------------------------------
# Frontend data source
# ---------------------------------------------------------------------------
# dev: API calls to the local FastAPI backend (default in development)
# static: reads the exported snapshot in web/frontend/public/data
#
# Production builds default to "static".
# VITE_DATA_MODE=static

# Optional external API base for non-static local builds.
VITE_API_BASE_URL=
